#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Modem Exporter add-on: take down the add-on if the exporter crashes
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "Modem Exporter crashed, halting add-on"
  echo "${1}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Modem Exporter stopped, restarting..."
