#!/usr/bin/env python3
"""Build prometheus.yml from the base template plus /share/prometheus/targets.

Each *.yaml / *.yml file in the targets directory holds one scrape job (a
mapping) or several (a list of mappings). The combined config is checked with
promtool before it replaces the live one, and Prometheus is then reloaded.

    combiner --once   build and write once (used before Prometheus starts)
    combiner          build, then rebuild whenever the targets change, and
                      reload Prometheus whenever the rules change
"""

import argparse
import glob
import hashlib
import logging
import os
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

import yaml

TEMPLATE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "prometheus.template")
TARGETS_DIR = os.environ.get("PROMETHEUS_TARGETS_DIR", "/share/prometheus/targets")
RULES_DIR = os.environ.get("PROMETHEUS_RULES_DIR", "/share/prometheus/rules")
CONFIG_FILE = os.environ.get("PROMETHEUS_CONFIG_FILE", "/etc/prometheus/prometheus.yml")
RELOAD_URL = "http://localhost:9090/-/reload"
POLL_SECONDS = 5

logging.basicConfig(level=logging.INFO, format="[configgen] %(levelname)s: %(message)s")
log = logging.getLogger("configgen")


def yaml_files(directory: str) -> list[str]:
    files = glob.glob(os.path.join(directory, "*.yaml")) + glob.glob(os.path.join(directory, "*.yml"))
    return sorted(files)


def target_files() -> list[str]:
    return yaml_files(TARGETS_DIR)


# path -> (mtime_ns, size, md5 of contents)
_hashes: dict[str, tuple[int, int, str]] = {}


def file_hash(path: str) -> str:
    """md5 of the file's contents, re-read only when its mtime or size
    changes, so polling stays cheap."""
    st = os.stat(path)
    cached = _hashes.get(path)
    if cached and cached[:2] == (st.st_mtime_ns, st.st_size):
        return cached[2]
    with open(path, "rb") as f:
        digest = hashlib.md5(f.read(), usedforsecurity=False).hexdigest()
    _hashes[path] = (st.st_mtime_ns, st.st_size, digest)
    return digest


def fingerprint(directory: str) -> tuple:
    """Changes when a file in the directory is added or removed, or its
    contents change. Saving a file without changing it doesn't count."""
    out = []
    for path in yaml_files(directory):
        try:
            out.append((path, file_hash(path)))
        except FileNotFoundError:
            continue
    return tuple(out)


def load_template() -> dict:
    with open(TEMPLATE, encoding="utf-8") as f:
        return yaml.safe_load(f)


def load_targets() -> list[dict]:
    jobs: list[dict] = []
    for path in target_files():
        with open(path, encoding="utf-8") as f:
            data = yaml.safe_load(f)
        if data is None:
            continue
        items = data if isinstance(data, list) else [data]
        for item in items:
            if not isinstance(item, dict):
                raise ValueError(f"{path}: expected a scrape job mapping, got {type(item).__name__}")
            jobs.append(item)
    return jobs


def render(jobs: list[dict]) -> str:
    config = load_template()
    config["scrape_configs"] = config.get("scrape_configs", []) + jobs
    return yaml.safe_dump(config, default_flow_style=False, sort_keys=False)


def check(config: str) -> None:
    """Raise with promtool's output if the config is invalid."""
    with tempfile.NamedTemporaryFile("w", suffix=".yml", delete=False) as tmp:
        tmp.write(config)
    try:
        # --syntax-only: the base config's credentials file and rule globs are
        # checked for real by Prometheus itself.
        result = subprocess.run(
            ["promtool", "check", "config", "--syntax-only", tmp.name],
            capture_output=True,
            text=True,
            check=False,
        )
    finally:
        os.unlink(tmp.name)
    if result.returncode != 0:
        raise ValueError((result.stdout + result.stderr).strip())


def write(config: str) -> bool:
    """Atomically replace the live config. Returns False if it was unchanged."""
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            if f.read() == config:
                return False
    except FileNotFoundError:
        pass
    tmp = f"{CONFIG_FILE}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(config)
    os.replace(tmp, CONFIG_FILE)
    return True


def reload_prometheus() -> bool:
    """Returns False if the reload request didn't succeed. An HTTP error
    means Prometheus rejected the new config or rules (it says why in its
    log), which retrying won't fix."""
    req = urllib.request.Request(RELOAD_URL, data=b"", method="POST")
    try:
        with urllib.request.urlopen(req, timeout=10):
            pass
        log.info("Prometheus reloaded")
    except urllib.error.HTTPError as e:
        log.error("Prometheus rejected the reload (see its log): %s", e)
    except Exception as e:  # Prometheus may still be starting
        log.warning("Could not reach Prometheus to reload it, will retry: %s", e)
        return False
    return True


def build() -> str:
    jobs = load_targets()
    config = render(jobs)
    check(config)
    log.info("Built config with %d job(s) from %s", len(jobs), TARGETS_DIR)
    return config


def once() -> int:
    try:
        config = build()
    except Exception as e:
        log.error("Targets are invalid, starting with the built-in jobs only:\n%s", e)
        config = render([])
        check(config)
    write(config)
    return 0


def watch() -> int:
    last_targets = None
    last_rules = fingerprint(RULES_DIR)
    # Carried across polls, so a reload that couldn't reach Prometheus is
    # retried even if nothing else changes.
    reload = False
    while True:
        targets = fingerprint(TARGETS_DIR)
        if targets != last_targets:
            last_targets = targets
            try:
                reload = write(build()) or reload
            except Exception as e:
                log.error("Keeping the current config, the new one is invalid:\n%s", e)
        rules = fingerprint(RULES_DIR)
        if rules != last_rules:
            last_rules = rules
            log.info("Rules changed in %s", RULES_DIR)
            reload = True
        if reload:
            reload = not reload_prometheus()
        time.sleep(POLL_SECONDS)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--once", action="store_true", help="build once and exit")
    args = parser.parse_args()
    return once() if args.once else watch()


if __name__ == "__main__":
    sys.exit(main())
