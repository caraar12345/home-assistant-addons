#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Prometheus add-on: take down the add-on if prometheus-configgen crashes
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "The Prometheus config generator crashed, halting add-on"
  echo "${1}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "The Prometheus config generator stopped, restarting..."
