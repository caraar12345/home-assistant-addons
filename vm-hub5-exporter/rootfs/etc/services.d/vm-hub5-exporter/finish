#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# vm-hub5-exporter add-on: take down the add-on if the exporter crashes
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "vm-hub5-exporter crashed, halting add-on"
  echo "${1}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "vm-hub5-exporter stopped, restarting..."
