caddy
.DS_Store
promtail/testConfig/*

# The bare "caddy" pattern above matches any path component named "caddy" anywhere in
# the tree, which also swallows this add-on's own caddy/ directories - un-ignore them.
!/ma-ingress-proxy/rootfs/etc/caddy/
!/ma-ingress-proxy/rootfs/etc/caddy/**
!/ma-ingress-proxy/rootfs/etc/services.d/caddy/
!/ma-ingress-proxy/rootfs/etc/services.d/caddy/**